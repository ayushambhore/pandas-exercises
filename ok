import numpy as np
import matplotlib.pyplot as plt
from scipy.cluster.hierarchy import linkage, dendrogram

# --- Step 1: Sample data ---
from sklearn.datasets import make_blobs
X, _ = make_blobs(n_samples=20, centers=3, random_state=42)

# --- Step 2: Hierarchical clustering ---
Z = linkage(X, method='ward')

# --- Step 3: Create dendrogram to extract coordinates ---
ddata = dendrogram(Z, no_plot=True)

# --- Step 4: Convert to polar coordinates manually ---
icoord = np.array(ddata['icoord'])
dcoord = np.array(ddata['dcoord'])
labels = ddata['ivl']

# Normalize angles and distances
max_radius = np.max(dcoord)
angles = np.linspace(0, 2 * np.pi, icoord.shape[0] * 4)
angle_map = {}

for i, label in enumerate(ddata['leaves']):
    angle_map[label] = 2 * np.pi * i / len(ddata['leaves'])

# Prepare polar plot
fig, ax = plt.subplots(figsize=(10, 10), subplot_kw={'projection': 'polar'})
ax.set_xticks([])
ax.set_yticks([])
ax.set_theta_direction(-1)
ax.set_theta_offset(np.pi / 2)

# --- Step 5: Draw lines in polar coordinates ---
for xs, ys in zip(icoord, dcoord):
    # Convert x (horizontal coord) to angle
    angles = [2 * np.pi * (x - min(icoord.flatten())) / (max(icoord.flatten()) - min(icoord.flatten())) for x in xs]
    radii = [max_radius - y for y in ys]  # flip Y to make root at center
    ax.plot(angles, radii, color='black')

# --- Step 6: Label leaves (optional) ---
for i, label in enumerate(ddata['leaves']):
    angle = angle_map[label]
    radius = 0  # leaves at outer edge
    ax.text(angle, max_radius + 1.5, str(label),
            rotation=np.degrees(angle),
            rotation_mode='anchor',
            ha='center', va='center')

plt.title("True Radial Dendrogram (Matplotlib + Scipy)", va='bottom')
plt.tight_layout()
plt.show()
