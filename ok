import pandas as pd
import re
import json

def fix_logprobs_string(raw_str):
    if pd.isnull(raw_str):
        return None
    
    # Convert to string (if not already)
    raw_str = str(raw_str)

    # Replace weird quotes and formatting
    raw_str = raw_str.replace("'", '"')  # Replace single with double quotes
    raw_str = raw_str.replace("“", '"').replace("”", '"')  # Fix fancy quotes
    raw_str = re.sub(r'[\n\r\t]', ' ', raw_str)  # Remove newlines and tabs

    # Replace semi-colons, missing commas, etc.
    raw_str = raw_str.replace('}. {', '}, {')
    raw_str = raw_str.replace('}{', '},{')

    # Fix keys if missing quotes
    raw_str = re.sub(r'(\w+)\s*:', r'"\1":', raw_str)

    # Extract all dicts from the messy string using regex
    matches = re.findall(r'\{"token":\s*".*?",\s*"Logprob":\s*[-]?[0-9.]+\}', raw_str)

    # Now safely load each one
    dicts = []
    for match in matches:
        try:
            d = json.loads(match)
            dicts.append(d)
        except json.JSONDecodeError:
            continue

    return dicts if dicts else None
