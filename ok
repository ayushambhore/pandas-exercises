import pandas as pd
import json
import re

# Function to clean and parse malformed JSON strings
def clean_logprobs(raw_str):
    try:
        # Try loading directly first
        return json.loads(raw_str)
    except (TypeError, json.JSONDecodeError):
        try:
            # Basic cleaning: replace single quotes with double quotes
            raw_str = str(raw_str).replace("'", '"')

            # Fix common issues
            raw_str = raw_str.strip().strip("*").strip()
            
            # Fix missing commas between items if needed (optional, depends on structure)
            raw_str = re.sub(r'}\s*{', '},{', raw_str)

            # Enclose in square brackets if it's a series of dicts not in list format
            if not raw_str.startswith("["):
                raw_str = "[" + raw_str + "]"

            return json.loads(raw_str)
        except Exception as e:
            print(f"Failed to parse: {raw_str}\nError: {e}")
            return None  # or return raw_str if you want to keep unparsed

