import xml.etree.ElementTree as ET
import csv

def xml_to_csv_nested(input_xml_path, output_csv_path):
    tree = ET.parse(input_xml_path)
    root = tree.getroot()

    stories = root.findall('.//Story')
    if not stories:
        print("No <Story> elements found.")
        return

    records = []
    all_keys = set()

    for story in stories:
        base_data = {}
        # Direct children
        for child in story:
            if child.tag == 'Metadata':
                for meta in child:
                    base_data[meta.tag] = meta.text
                    all_keys.add(meta.tag)
            elif child.tag == 'AssignedTickers':
                # Special handling for nested scored entities
                scored_entities = child.findall('.//ScoredEntity')
                for entity in scored_entities:
                    row = base_data.copy()
                    for e_child in entity:
                        row[f'ScoredEntity_{e_child.tag}'] = e_child.text
                        all_keys.add(f'ScoredEntity_{e_child.tag}')
                    records.append(row)
            else:
                base_data[child.tag] = child.text
                all_keys.add(child.tag)

        # If no scored entity, still keep the base row
        if not story.find('.//AssignedTickers'):
            records.append(base_data)

    # Write CSV
    all_keys = sorted(all_keys)
    with open(output_csv_path, 'w', newline='', encoding='utf-8') as f:
        writer = csv.DictWriter(f, fieldnames=all_keys)
        writer.writeheader()
        for record in records:
            writer.writerow(record)

    print(f"CSV written to: {output_csv_path}")
