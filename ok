import pandas as pd
import numpy as np
from sklearn_extra.cluster import KMedoids
from scipy.spatial.distance import pdist, squareform

# Example DataFrame with named columns
df = pd.DataFrame(
    np.random.rand(100, 10),
    columns=[f'col{i}' for i in range(10)]  # your original column names
)

# Step 1: Compute column-wise distance matrix
D = pdist(df.T)  # transpose to cluster columns
D_square = squareform(D)

# Step 2: Run K-Medoids clustering
k = 3
kmedoids = KMedoids(n_clusters=k, metric='precomputed', random_state=42)
kmedoids.fit(D_square)

# Step 3: Get original column names and their cluster IDs
column_names = df.columns.tolist()
cluster_labels = kmedoids.labels_

# Step 4: Group columns by cluster ID
cluster_dict = {}
for col_name, cluster_id in zip(column_names, cluster_labels):
    cluster_dict.setdefault(cluster_id, []).append(col_name)

# Step 5: Convert to DataFrame
cluster_df = pd.DataFrame([
    {'ClusterID': cluster_id, 'Members': ', '.join(members)}
    for cluster_id, members in sorted(cluster_dict.items())
])

# Optional: Save to CSV
cluster_df.to_csv("kmedoids_column_clusters.csv", index=False)

print(cluster_df)
