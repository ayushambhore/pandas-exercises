from sklearn.model_selection import GridSearchCV, TimeSeriesSplit
from sklearn.metrics import mean_squared_error
from scipy.stats import pearsonr
import pandas as pd
import numpy as np

def grid_search_ts(self, inp_data, x_l, y_l, method, split_count, param_d, score_type, jobs_val):
    try:
        # TimeSeriesSplit setup
        tscv = TimeSeriesSplit(n_splits=split_count)
        inp_d = inp_data.copy()

        # Step 1: Run GridSearchCV with neg MSE as refit
        met_grid = GridSearchCV(
            estimator=method,
            param_grid=param_d,
            cv=tscv,
            n_jobs=jobs_val,
            verbose=4,
            scoring=score_type,
            error_score="raise",
            refit='neg_mean_squared_error'
        )

        met_grid.fit(inp_d[x_l], inp_d[y_l])
        met_grid_results = pd.DataFrame(met_grid.cv_results_)

        # Step 2: Manually run TSCV to compute correlation between 'returns' and 'gtech' for each split
        correlations = []
        split_index = 1

        for train_idx, test_idx in tscv.split(inp_d):
            test_df = inp_d.iloc[test_idx].copy()

            # Make predictions with best estimator
            X_test = test_df[x_l]
            y_pred = met_grid.best_estimator_.predict(X_test)

            # Save predictions to 'gtech'
            test_df['gtech'] = y_pred

            # Ensure 'returns' and 'gtech' are present
            if 'returns' in test_df.columns:
                corr_val = pearsonr(test_df['returns'], test_df['gtech'])[0]
            else:
                corr_val = np.nan

            correlations.append({'Split': split_index, 'Correlation': corr_val})
            split_index += 1

        corr_df = pd.DataFrame(correlations)

        # Step 3: Return both results
        return met_grid_results, corr_df

    except Exception as e:
        print(f"Error in grid_search_ts: {e}")
